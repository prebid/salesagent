# AdCP Sales Agent - Environment Configuration
# =============================================
#
# Quick Start: Just run `docker compose up` - test mode works with no configuration!
#
# For production deployment, see: docs/deployment/environment-variables.md
#
# Copy this file to .env:  cp .env.template .env

# ============================================
# [OPTIONAL] Super Admin Access
# ============================================
# In test mode (default), use the test login buttons instead.
# For production, set your email(s) or domain(s) here:
# SUPER_ADMIN_EMAILS=your-email@example.com
# SUPER_ADMIN_DOMAINS=example.com

# ============================================
# [OPTIONAL] Authentication
# ============================================
# Sign-in is OAuth/OIDC only. Configure a provider below and list the administrators
# who may sign in; a tenant still setting up its own SSO uses per-tenant Setup Mode,
# which allows an OIDC login before that tenant's SSO is enabled.
#
# SUPER_ADMIN_EMAILS=you@example.com

# --------------------------------------------
# OAuth Configuration
# --------------------------------------------
# Works with ANY OIDC provider: Google, Okta, Auth0, Azure AD, Keycloak, etc.
#
# 1. Get your provider's OIDC discovery URL (ends in /.well-known/openid-configuration)
# 2. Create an OAuth application in your provider
# 3. Add redirect URI: http://localhost:8001/auth/google/callback
# 4. Enter credentials below:
#
# OAUTH_DISCOVERY_URL=https://your-provider.com/.well-known/openid-configuration
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_CLIENT_SECRET=your-client-secret
# OAUTH_SCOPES=openid email profile  # Optional, defaults to "openid email profile"

# Common discovery URLs:
#   Google:    https://accounts.google.com/.well-known/openid-configuration
#   Microsoft: https://login.microsoftonline.com/{tenant-id}/v2.0/.well-known/openid-configuration
#   Okta:      https://{your-domain}.okta.com/.well-known/openid-configuration
#   Auth0:     https://{your-tenant}.auth0.com/.well-known/openid-configuration
#   Keycloak:  https://{server}/realms/{realm}/.well-known/openid-configuration

# ============================================
# [OPTIONAL] Google Ad Manager Integration
# ============================================
# Required ONLY if using GAM adapter with OAuth authentication.
# Service Account auth (recommended) can be configured in Admin UI instead.
#
# IMPORTANT: These are DIFFERENT from Admin UI OAuth credentials above!
# GAM_OAUTH_CLIENT_ID=your-gam-client-id
# GAM_OAUTH_CLIENT_SECRET=your-gam-client-secret

# ============================================
# [OPTIONAL] Control-Plane API Keys
# ============================================
# Keys for programmatic tenant management and sync APIs.
# Generate with: python -c "import secrets; print(f'sk-{secrets.token_urlsafe(32)}')"
#
# Tenant Management API — create/update/delete tenants (header: X-Tenant-Management-API-Key)
# TENANT_MANAGEMENT_API_KEY=
#
# Sync API — trigger inventory syncs, view sync history (header: X-API-Key)
# SYNC_API_KEY=

# ============================================
# [AUTO-GENERATED] Encryption
# ============================================
# Used to encrypt sensitive data (e.g., GAM service account credentials) in the database.
# Auto-generated by `make setup` / `scripts/setup-dev.py` if not already set.
# For production: generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# ============================================
# [OPTIONAL] Advanced Settings
# ============================================
# AI features (Gemini API key) are configured per-tenant in the Admin UI.
# See docs/deployment/environment-variables.md for all options.

# Schema validation strictness:
#   development (default): Strict - rejects unknown fields in AdCP requests
#   production: Lenient - ignores unknown fields for forward compatibility
# ENVIRONMENT=production

# Demo tenant creation (default: false)
# When true, creates a "Default Publisher" tenant with mock adapter on first startup
# Set to true for local development/evaluation, leave false for production deployments
# CREATE_DEMO_TENANT=true
