# Local configuration
config.json
__pycache__
adcp.db
*.db
.env
.env.local
.env.production
.env.secrets

# Test configurations (contain test network IDs - should not be in production)
.gam-test-config.json
gam_ad_units.json

# OAuth credentials
client_secret*.json
credentials*.json

# GCP Service Account Keys
*-key.json
adcp-manager-key.json
# ...except the vendored AdCP schema fixtures, which are JSON Schema documents
# named after the thing they describe (agent-signing-key.json, activation-key.json)
# and carry no credentials. Without this the `$ref` closure a pinned-schema test
# validates against is incomplete on any fresh checkout, and the failure surfaces
# as an unresolvable `$ref` far from its cause.
!tests/fixtures/adcp_schemas_pinned/**/*-key.json

# Build artifacts
*.egg-info/
*.egg-info
dist/
build/

# Logs
logs/
audit_logs/
*.log

# Virtual environment
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Python
*.pyc

# Diagnostic scripts (one-off debugging tools)
# BUT: Allow pre-commit hooks and scripts/ directory
check_*.py
!.pre-commit-hooks/check_*.py
!scripts/check_*.py
diagnose_*.py
fix_*.py
sync_*.py
!scripts/**/sync_*.py
!src/**/sync_*.py
test_sync.py

# One-off test scripts in root (proper tests belong in tests/)
/test_*.py
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
.pytest_cache/
nosetests.xml
coverage.xml
coverage.json
htmlcov/
*.cover
.hypothesis/

# Docker
docker-compose.override.yml

# Temporary files
*.tmp
*.bak
*.backup
temp/
tmp/
test_auth_state.json
screenshots/

# Review/planning documents (use issues/PRs instead)
*-review.md
*-plan.md

# Generated PR summaries
.git-pr-summary.md

# Local symlinks to external repos
adcp-spec

# Runtime files
*.pid
server.pid

# Conductor workspace files
conductor_ports.json
conductor_ports.lock


# Generated compliance report (tests/e2e/test_adcp_schema_compliance.py::test_save_compliance_report
# writes to Path(__file__).parent / "schemas" / "compliance_report.json")
tests/e2e/schemas/


# Test database files (PostgreSQL test databases)
# Only ignore database files/dirs, not test_*.py files
test_*.db
test_*.db-*
test_*[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/
.env.test
test_sync.py
.env.bak*

# Test results (JSON reports from ./run_all_tests.sh)
test-results/

# pytest-playwright artifacts (pytest.ini --output; kept out of test-results/ because
# the plugin wipes its output directory at every session start)
.playwright-artifacts/

# Docker test stack env (generated by scripts/test-stack.sh)
.test-stack.env

# Test-stack TLS material (generated by scripts/dev/gen_test_tls.py).
# A private CA + leaf so the e2e stacks can SERVE https at a dotted host instead
# of merely advertising it. Build artifact — regenerated on demand, never committed.
.test-tls/

# Agent DB state (generated by .claude/skills/agent-db/agent-db.sh, per-worktree)
.agent-db.env

# Agentic coding — local-only files
.beads
.claude/research/
.claude/code-review/
.claude/settings.local.json
.claude/agent-memory/
.claude/agents/review-*.md
.claude/commands/code-review.md
.claude/skills/code-review/
.claude/reports
.claude/scheduled_tasks.lock
.perles/

# Private local rules (agent tooling, personal workflows)
.claude/rules/private/

# One-off presentation drafts
docs/TRANSFORMATION_PRESENTATION.md

# cassini run record, rewritten by every test slice — never a repo artifact
manifest.json

# adcp spec fetch cache (mirrored URL paths); no code reads the local copy
/schemas/
# Session working notes — scratch, never a deliverable. The PR is their home.
.claude/notes/

# The pinned AdCP compliance bundle: a downloaded GitHub release asset, not source.
# .github/actions/_adcp-bundle fetches and sha256-verifies it; the extracted tree is
# already ignored by tests/storyboard/runner/.gitignore.
tests/storyboard/runner/*.tgz
tests/storyboard/runner/*.tgz.sha256

# The RFC 9421 merge audit trail keeps its ledger, gate and manifest; the bulk
# intermediates (per-parent node-id baselines, per-stage agent results) are
# regenerable and stay out of the history.
.claude/merge-review/baselines/
.claude/merge-review/batches/
.claude/merge-review/stage*_result.json
.claude/merge-review/stage*_files.json
.claude/merge-review/stage*_owed*
.claude/merge-review/classification.json
.claude/merge-review/unitgreen_result.json
.claude/merge-review/conflicts.txt
.claude/merge-review/full_theirs.txt
.claude/merge-review/silent.txt
.claude/merge-review/remaining_markers.txt
