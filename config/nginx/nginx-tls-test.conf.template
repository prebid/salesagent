# TLS listener for the E2E TEST STACKS ONLY (salesagent-tgzb).
#
# Deliberately a SEPARATE file from nginx-development.conf: that one is mounted
# as the whole /etc/nginx/nginx.conf by BOTH docker-compose.e2e.yml AND
# docker-compose.yml, so putting ssl_certificate there would break a plain
# `docker compose up` on any machine that has not generated a certificate.
# This file is a conf.d SNIPPET rendered by the stock nginx:stable entrypoint
# (NGINX_ENVSUBST_TEMPLATE_DIR), so the image needs no Dockerfile of its own.
#
# ${TLS_UPSTREAM} is the ONLY substitution — nginx's own $variables are written
# without braces, which envsubst leaves alone. This ONE template serves THREE
# call sites (salesagent-amht.2):
#   - the shared stack's default `tls-proxy` instance — every dotted alias it
#     carries is routed by the $ssl_server_name map below, not by
#     ${TLS_UPSTREAM}, which that instance sets only as the map's fallback;
#   - each bdd_e2e per-worker sidecar (run_all_tests.sh, `docker compose run
#     tls-proxy`), whose dotted CONTAINER NAME (its only DNS label — `run` has
#     no --network-alias) matches nothing in the map, so it always falls
#     through to its own ${TLS_UPSTREAM} (<project>-server-gwN:8080);
#   - scripts/creative-agent-stack.sh's standalone `docker run` of this same
#     image+template for the host CI matrix group, same fallback reasoning.
#
# The certificate is generated by scripts/dev/gen_test_tls.py and mounted at
# /app/.test-tls (the same path the runner sees it at through the repo bind
# mount, so E2E_CA_BUNDLE reads identically on both sides). It carries TWO
# wildcards, and the split is deliberate:
#   - *.adcp.test  — the in-stack fronts the RUNNER dials (proxy,
#     creative-agent, storyboard, and the per-worker sidecars' dotted
#     container names);
#   - *.adcp-e2e.dev — the origins the SERVER dials OUTBOUND, which cannot live
#     under .test (see the map below). Adding an origin under either wildcard is
#     one alias plus one map line and needs no new certificate material.

map $http_upgrade $tls_connection_upgrade {
    default upgrade;
    ''      close;
}

# SNI-routed upstreams (salesagent-mp53.9, salesagent-amht.2). Route by the TLS
# ClientHello's SNI name. ONE terminating front serves every TLS origin in the
# stack; which upstream a connection reaches is decided by the name the client
# asked for, not by a second `listen ... ssl` server block. A second front would
# mean a second certificate and a second place to keep the SANs in step.
#
# `default ""` is not a real upstream: it lets the server block detect "no
# match" and fall back to ${TLS_UPSTREAM}, which is what lets the SAME template
# serve the shared stack's multi-alias front and the single-upstream
# sidecars/standalone runs described above. Adding a dialed origin to the shared
# front is one alias (docker-compose.e2e.yml) plus one line here.
#
# Every upstream is PLAINTEXT behind this front by design: the front terminates
# TLS, the origin services never do. Every name here must be covered by
# SAN_DNS_NAMES in scripts/dev/gen_test_tls.py or the handshake fails before a
# byte of HTTP moves, and every service named here must be in the `dc up -d`
# list in run_all_tests.sh or nginx answers 502 (both are enforced by
# tests/unit/test_architecture_e2e_*.py).
map $ssl_server_name $tls_upstream_named {
    default                    "";

    # ── In-stack fronts the RUNNER dials — under *.adcp.test ──
    # The sales agent itself. Also the TLS_UPSTREAM default, so this line is
    # belt-and-braces for the shared stack and a no-op for the sidecars.
    # (Write TLS_UPSTREAM bare inside this block, never envsubst-wrapped: the
    # structural guards match this map's body with a negated-character-class
    # regex that stops at the first closing brace, so a closing brace in a
    # comment here silently truncates their view of the routes below it.)
    proxy.adcp.test            adcp-server:8080;
    creative-agent.adcp.test   creative-agent:8080;
    # The storyboard agent. Fronted for A2A's sake: A2A is card-first, and the
    # card renders https for any non-loopback host, so dialed plaintext on :8080
    # it published `https://adcp-server-storyboard:8080/a2a` and every
    # card-derived call failed. Behind this front the scheme the card publishes
    # is the scheme the origin speaks.
    storyboard.adcp.test       adcp-server-storyboard:8080;

    # ── Origins the SERVER dials OUTBOUND — under *.adcp-e2e.dev ──
    # These CANNOT live under .test, and for two DIFFERENT reasons (the first
    # does not imply the second — see scripts/dev/gen_test_tls.py):
    #   * the webhook receiver — AdCP 3.1.1 lists `.test` among the RFC 6761
    #     special-use names a seller MUST refuse, and the proof-of-control
    #     prover enforces that unconditionally (notification_proof_service ->
    #     is_reserved_tld_host) BEFORE the SSRF check, so delivery to a `.test`
    #     receiver is refused before a socket opens;
    #   * the counterparty identity origin the INBOUND verifier walks
    #     (salesagent-mp53.8) — that reserved-TLD rule does not reach the
    #     inbound walk, but Tier 3 brand authorization matches agent url to
    #     brand domain by eTLD+1, and `.test` is not in the public suffix list.
    webhooks.adcp-e2e.dev      webhook-capture:8080;
    counterparty.adcp-e2e.dev  counterparty-origin:8080;

    # Retained alongside webhooks.adcp-e2e.dev, same upstream: the READBACK leg
    # (the test process draining its own captures) and the tls-proxy healthcheck
    # are not the graded delivery path, so the reserved-TLD gate above never
    # runs for them and this alias stays valid. Costs nothing if compose stops
    # advertising it — an unrouted map key is inert.
    webhooks.adcp.test         webhook-capture:8080;
}

server {
    listen 8443 ssl;
    server_name _;

    ssl_certificate     /app/.test-tls/server.pem;
    ssl_certificate_key /app/.test-tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Docker's embedded DNS, resolved per request: the sidecar can start before
    # its upstream server container exists (they are launched in the same loop).
    resolver 127.0.0.11 valid=30s ipv6=off;
    # The SNI map wins; ${TLS_UPSTREAM} is only its fallback. nginx has no
    # conditional assignment, so this is `set` then override — and `if` inside a
    # server block is safe for exactly this (a plain variable set, no rewrite).
    set $tls_upstream_fallback "${TLS_UPSTREAM}";
    set $tls_upstream $tls_upstream_named;
    if ($tls_upstream = "") {
        set $tls_upstream $tls_upstream_fallback;
    }

    # Health — proxied to the upstream so it reflects app readiness, not nginx's.
    location /health {
        access_log off;
        proxy_pass http://$tls_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
    }

    location = / {
        proxy_pass http://$tls_upstream/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Host is forwarded verbatim ($http_host, port included): the server routes
    # tenants by an EXACT match on the Host header (get_tenant_by_virtual_host),
    # so rewriting it here would make the tenant unroutable over TLS.
    location / {
        proxy_pass http://$tls_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $tls_connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header x-adcp-auth $http_x_adcp_auth;
        proxy_cache_bypass $http_upgrade;
    }
}
